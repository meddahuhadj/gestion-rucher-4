# apps/api/.env  — copier depuis ce fichier

DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Vérification des JWT — au choix :
#  - projets récents (clés asymétriques) : renseigner l'URL JWKS
SUPABASE_JWT_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
#  - projets legacy (secret HS256, Settings > API > JWT Secret) :
SUPABASE_JWT_SECRET=

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# modèle audio natif pour la conversation vocale temps réel (§6)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_AI_PER_MIN=20
LOG_LEVEL=debug
NODE_ENV=development
