# Build de production (Vercel). Chargé automatiquement par `vite build`.
# L'API est proxifiée same-origin par vercel.json (/api/* → service Render),
# ce qui évite tout CORS et garde le Service Worker offline fonctionnel.
VITE_API_BASE_URL=/api/v1
VITE_DEFAULT_LOCALE=fr
VITE_SUPABASE_URL=https://qqnzsttvgbasukbfcgzq.supabase.co

# VITE_SUPABASE_ANON_KEY : clé publique `anon` — à définir dans
# Vercel → Project → Settings → Environment Variables.
