# Build de production (Render static site). Chargé automatiquement par `vite build`.
# L'API est proxifiée same-origin par render.yaml (/api/* → service API Render).
VITE_API_BASE_URL=/api/v1
VITE_DEFAULT_LOCALE=fr

# Pas de Supabase Auth pour l'instant : on autorise le bouton "connexion dev"
# (côté API : ALLOW_DEBUG_AUTH=true). À passer à false quand Supabase Auth sera
# branché (définir VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY).
VITE_ALLOW_DEV_LOGIN=true
