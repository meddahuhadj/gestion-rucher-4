# ─────────────────────────────────────────────────────────────
# MOUMEN Apiary AI — exemple de configuration
# Copier vers .env (racine non utilisée : voir apps/api/.env et apps/web/.env)
# ─────────────────────────────────────────────────────────────

# --- Supabase (projet) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...              # clé publique (protégée par RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # SERVEUR UNIQUEMENT — ne jamais exposer au client
SUPABASE_JWT_SECRET=super-secret      # pour vérifier les JWT côté API (HS256) — ou JWKS

# --- Base de données (Prisma / API) ---
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- IA ---
AI_PROVIDER=gemini
GEMINI_API_KEY=                       # SERVEUR UNIQUEMENT
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_AI_PER_MIN=20
LOG_LEVEL=info

# --- Équipe co-propriétaire (multi-utilisateur léger) ---
# IDs Supabase (auth.users.id) séparés par des virgules. Tous ces comptes
# partagent le MÊME périmètre de données. Le PREMIER id est le propriétaire
# canonique (colonne owner_id). `created_by` et l'audit gardent l'auteur réel.
# Laisser vide = un compte = ses propres données.
# Ex. Moumen (propriétaire) + Hdj :
# TEAM_MEMBER_IDS=00000000-moumen-uuid,11111111-hdj-uuid
TEAM_MEMBER_IDS=

# --- Web (préfixe VITE_, valeurs publiques) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_DEFAULT_LOCALE=fr
